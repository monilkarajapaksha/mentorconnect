{
  "name": "calllog",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @calllog/api\" \"npm run dev -w @calllog/web\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gen:migration-check": "npm run test -w @calllog/shared",
    "build": "npm run build -w @calllog/web",
    "deploy:api": "npm run deploy -w @calllog/api",
    "deploy:web": "npm run build -w @calllog/web && cd apps/web && npx wrangler pages deploy dist --project-name calllog-web --branch main"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
